{
  "manifest_version": 3,
  "name": "SIH26171 Privacy Browser Assistant",
  "version": "1.0.0",
  "description": "Privacy-first browser assistant that detects and sanitizes PII locally before sending context to remote AI.",
  "permissions": [
    "activeTab",
    "offscreen",
    "sidePanel",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://api.groq.com/*",
    "https://openrouter.ai/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "theme.js",
        "detectors/domDetector.js",
        "detectors/regexDetector.js",
        "detectors/ocrDetector.js",
        "detectors/visionDetector.js",
        "vision/mediaPipeLoader.js",
        "vision/visualPipeline.js",
        "metrics.js",
        "detectionGate.js",
        "detectionFusion.js",
        "vision/redactor.js",
        "elementRegistry.js",
        "sanitize.js",
        "validate.js",
        "execute.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["vendor/**", "vision/**"],
      "matches": ["<all_urls>"]
    }
  ]
}
